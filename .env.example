# Copy this file to .env and fill in the values you need. docker-compose
# automatically picks up a .env file in the project root, and the Makefile
# targets will inherit the variables.
#
# Everything here has a sensible default in the backend config, so the only
# variable you actually need to set for a real extraction run is
# ANTHROPIC_API_KEY. Without it the system falls back to a regex extractor
# and the whole pipeline still works end-to-end.

# -- LLM --------------------------------------------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# -- ASR --------------------------------------------------------------------
# One of: mock | openai_whisper | faster_whisper
#   mock             returns a fixed paramedic-narration transcript
#   openai_whisper   calls Whisper-1 via the OpenAI API (needs OPENAI_API_KEY)
#   faster_whisper   runs faster-whisper locally (heavier dep, CPU or GPU)
ASR_BACKEND=mock
OPENAI_API_KEY=

# -- Database ---------------------------------------------------------------
# These match the values baked into docker-compose.yml. Change them only if
# you're pointing the backend at an external MySQL.
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=dev
MYSQL_DATABASE=caresync
MYSQL_POOL_SIZE=10

# -- Pipeline ---------------------------------------------------------------
# Upper bound on concurrent extraction jobs. Protects the LLM rate limit and
# the DB pool. Tune per deployment.
MAX_CONCURRENT_JOBS=4

# -- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
